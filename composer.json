{
    "name": "publishlayer/laravel-connector",
    "description": "Sync and render PublishLayer knowledge base content inside Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "publishlayer",
        "laravel",
        "knowledge-base",
        "markdown",
        "webhooks"
    ],
    "homepage": "https://github.com/publishlayer/laravel-connector",
    "authors": [
        {
            "name": "PublishLayer",
            "homepage": "https://github.com/publishlayer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.5"
    },
    "autoload": {
        "psr-4": {
            "PublishLayer\\LaravelConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PublishLayer\\LaravelConnector\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/publishlayer/laravel-connector/issues",
        "source": "https://github.com/publishlayer/laravel-connector",
        "docs": "https://github.com/publishlayer/laravel-connector#readme",
        "security": "https://github.com/publishlayer/laravel-connector/security"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "PublishLayer\\LaravelConnector\\PublishLayerServiceProvider"
            ],
            "aliases": {
                "PublishLayer": "PublishLayer\\LaravelConnector\\Facades\\PublishLayer"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:prefer-lowest": "composer update --prefer-lowest --prefer-stable && vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
